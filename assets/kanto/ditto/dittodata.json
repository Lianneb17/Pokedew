{
  "Changes": [
    {
      "Action": "Load",
      "FromFile": "assets/kanto/ditto/{{TargetWithoutPath}}.png",
      "LogName": "Load images",
      "Target": "ditto/ditto, ditto/dittos"
    },
    {
      "Action": "EditData",
      "Entries": {
        "{{modId}}_sound_ditto": {
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/kanto/ditto/ditto.wav}}"
          ],
          "ID": "{{modId}}_sound_ditto"
        }
      },
      "LogName": "Adding sound changes",
      "Target": "Data/AudioChanges"
    },
    {
      "Action": "EditData",
      "Entries": {
        "{{modId}}_pokemon_ditto": {
          "DisplayName": "{{i18n:pokemon.ditto}}",
          "House": "PokeBarn",
          "Gender": "MaleOrFemale",
          "EggItemIds": [
            "{{modId}}_item_egg_ditto",
            "{{modId}}_item_egg_group_ditto"
          ],
          "IncubationTime": "27000",
          "BirthText": "{{i18n:egg.all.hatching}}",
          "DaysToMature": "7",
          "CanGetPregnant": "False",
          "ProduceItemIds": [
            {
              "Id": "{{modId}}_pokemon_produceItem_egg_ditto",
