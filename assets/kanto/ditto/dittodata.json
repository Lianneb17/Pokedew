          "Type": "Basic",
          "Category": "-5",
          "Price": "500",
          "Texture": "eggs/color",
          "SpriteIndex": "6",
          "Edibility": "50",
          "ContextTags": [
            "egg_item",
            "color_purple"
          ],
          "ExcludeFromShippingCollection": "True",
          "ID": "{{modId}}_item_egg_ditto"
        }
      },
      "LogName": "Creating eggdata",
      "Target": "Data/ObjectChanges"
    },
    {
      "Action": "EditData",
      "Entries": {
        "{{modId}}_item_egg_ditto": {
          "AnimalSpawnList": [
            {
              "Id": "{{modId}}_egg_spawn_ditto",
              "AnimalId": "{{modId}}_pokemon_ditto"
            }
          ],
          "ID": "{{modId}}_item_egg_ditto"
        }
      },
      "LogName": "Adding egg extension changes",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData"
    }
