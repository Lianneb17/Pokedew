          "SpriteHeight": "21",
          "Skins": [
            {
              "ID": "{{modId}}_pokemon_ditto_shiny",
              "Weight": "0.1",
              "Texture": "ditto/dittos"
            }
          ],
          "SleepFrame": "16",
          "UseDoubleUniqueAnimationFrames": "True",
          "CanSwim": "False",
          "SellPrice": "5000",
          "ID": "{{modId}}_pokemon_ditto"
        }
      },
      "LogName": "Adding animal changes",
      "Target": "Data/AnimalChanges"
    },
    {
      "Action": "EditData",
      "Entries": {
        "{{modId}}_item_egg_ditto": {
          "Name": "{{modId}_item_egg_ditto",
