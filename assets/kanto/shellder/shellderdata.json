            "{{AbsoluteFilePath: assets/kanto/shellder/shellder.wav}}"
          ],
          "ID": "{{modId}}_sound_shellder"
        },
        "{{modId}}_sound_cloyster": {
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/kanto/shellder/cloyster.wav}}"
          ],
          "ID": "{{modId}}_sound_cloyster"
        }
      },
      "LogName": "Adding sound changes",
      "Target": "Data/AudioChanges"
    },
    {
      "Action": "EditData",
      "Entries": {
