          "Price": "500",
          "Texture": "eggs/color",
          "SpriteIndex": "6",
          "Edibility": "50",
          "ContextTags": [
            "egg_item",
            "color_purple"
          ],
          "ExcludeFromShippingCollection": "True",
          "ID": "{{modId}}_item_egg_shellder"
        }
      },
      "LogName": "Creating eggdata",
      "Target": "Data/ObjectChanges"
