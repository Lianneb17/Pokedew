            }
          ],
          "ID": "{{modId}}_item_egg_shellder"
        }
      },
      "LogName": "Adding egg extension changes",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData"
    },
    {
      "Action": "EditData",
      "Entries": {
        "{{modId}}_pokemon_shellder": {
          "IgnoreRain": "True",
